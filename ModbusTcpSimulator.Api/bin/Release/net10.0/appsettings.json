{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "Modbus": {
    "Host": "0.0.0.0",
    "Port": "502"
  },
  "Database": {
    "ConnectionString": "Data Source=simulator.db"
  },
  "WebSocket": {
    "BroadcastIntervalMs": "250"
  },
  "AllowedHosts": "*"
}
